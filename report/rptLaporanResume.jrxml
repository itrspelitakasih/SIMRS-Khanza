<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptLaporanResume" pageWidth="595" pageHeight="842" columnWidth="540" leftMargin="28" rightMargin="27" topMargin="20" bottomMargin="20" uuid="d28aff02-b871-4a95-a3ae-5422802647fd">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="ruang" class="java.lang.String"/>
	<parameter name="norawat" class="java.lang.String"/>
	<parameter name="tanggalkeluar" class="java.lang.String"/>
	<queryString>
		<![CDATA[select reg_periksa.no_rawat,reg_periksa.no_rkm_medis,pasien.nm_pasien,pasien.jk,date_format(pasien.tgl_lahir,'%d-%m-%Y') as tgllahir,
concat(reg_periksa.umurdaftar,' ',reg_periksa.sttsumur) as umur,concat(pasien.alamat,', ',kelurahan.nm_kel,', ',kecamatan.nm_kec,', ',kabupaten.nm_kab) as alamat,
dokter.nm_dokter,
concat(date_format(reg_periksa.tgl_registrasi,'%d-%m-%Y'),' ',reg_periksa.jam_reg) as tglmasuk,
resume_pasien.keluhan_utama,resume_pasien.jalannya_penyakit,resume_pasien.hasil_laborat,resume_pasien.pemeriksaan_penunjang,
(select group_concat(concat(databarang.nama_brng,' ',detail_pemberian_obat.jml,' ',databarang.kode_sat) order by detail_pemberian_obat.tgl_perawatan,detail_pemberian_obat.jam separator '\n')
 from detail_pemberian_obat inner join databarang on detail_pemberian_obat.kode_brng=databarang.kode_brng where detail_pemberian_obat.no_rawat=reg_periksa.no_rawat) as terapi,
concat_ws('\n',if(ifnull(resume_pasien.diagnosa_utama,'')<>'',concat('Diagnosa Utama : ',resume_pasien.diagnosa_utama,if(ifnull(resume_pasien.kd_diagnosa_utama,'')<>'',concat(' (',resume_pasien.kd_diagnosa_utama,')'),'')),null),if(ifnull(resume_pasien.diagnosa_sekunder,'')<>'',concat('Diagnosa Sekunder : ',resume_pasien.diagnosa_sekunder,if(ifnull(resume_pasien.kd_diagnosa_sekunder,'')<>'',concat(' (',resume_pasien.kd_diagnosa_sekunder,')'),'')),null),if(ifnull(resume_pasien.diagnosa_sekunder2,'')<>'',concat('Diagnosa Sekunder : ',resume_pasien.diagnosa_sekunder2,if(ifnull(resume_pasien.kd_diagnosa_sekunder2,'')<>'',concat(' (',resume_pasien.kd_diagnosa_sekunder2,')'),'')),null),if(ifnull(resume_pasien.diagnosa_sekunder3,'')<>'',concat('Diagnosa Sekunder : ',resume_pasien.diagnosa_sekunder3,if(ifnull(resume_pasien.kd_diagnosa_sekunder3,'')<>'',concat(' (',resume_pasien.kd_diagnosa_sekunder3,')'),'')),null),if(ifnull(resume_pasien.diagnosa_sekunder4,'')<>'',concat('Diagnosa Sekunder : ',resume_pasien.diagnosa_sekunder4,if(ifnull(resume_pasien.kd_diagnosa_sekunder4,'')<>'',concat(' (',resume_pasien.kd_diagnosa_sekunder4,')'),'')),null)) as diagnosa,
concat_ws('\n',if(ifnull(resume_pasien.prosedur_utama,'')<>'',concat('Prosedur Utama : ',resume_pasien.prosedur_utama,if(ifnull(resume_pasien.kd_prosedur_utama,'')<>'',concat(' (',resume_pasien.kd_prosedur_utama,')'),'')),null),if(ifnull(resume_pasien.prosedur_sekunder,'')<>'',concat('Prosedur Sekunder : ',resume_pasien.prosedur_sekunder,if(ifnull(resume_pasien.kd_prosedur_sekunder,'')<>'',concat(' (',resume_pasien.kd_prosedur_sekunder,')'),'')),null),if(ifnull(resume_pasien.prosedur_sekunder2,'')<>'',concat('Prosedur Sekunder : ',resume_pasien.prosedur_sekunder2,if(ifnull(resume_pasien.kd_prosedur_sekunder2,'')<>'',concat(' (',resume_pasien.kd_prosedur_sekunder2,')'),'')),null),if(ifnull(resume_pasien.prosedur_sekunder3,'')<>'',concat('Prosedur Sekunder : ',resume_pasien.prosedur_sekunder3,if(ifnull(resume_pasien.kd_prosedur_sekunder3,'')<>'',concat(' (',resume_pasien.kd_prosedur_sekunder3,')'),'')),null)) as tindakan,
resume_pasien.kondisi_pulang,resume_pasien.obat_pulang
from resume_pasien inner join reg_periksa on resume_pasien.no_rawat=reg_periksa.no_rawat
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
inner join kelurahan on pasien.kd_kel=kelurahan.kd_kel inner join kecamatan on pasien.kd_kec=kecamatan.kd_kec
inner join kabupaten on pasien.kd_kab=kabupaten.kd_kab
inner join dokter on resume_pasien.kd_dokter=dokter.kd_dokter
where resume_pasien.no_rawat=$P{norawat}]]>
	</queryString>
	<field name="no_rawat" class="java.lang.String"/>
	<field name="no_rkm_medis" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="jk" class="java.lang.String"/>
	<field name="tgllahir" class="java.lang.String"/>
	<field name="umur" class="java.lang.String"/>
	<field name="alamat" class="java.lang.String"/>
	<field name="nm_dokter" class="java.lang.String"/>
	<field name="tglmasuk" class="java.lang.String"/>
	<field name="keluhan_utama" class="java.lang.String"/>
	<field name="jalannya_penyakit" class="java.lang.String"/>
	<field name="hasil_laborat" class="java.lang.String"/>
	<field name="pemeriksaan_penunjang" class="java.lang.String"/>
	<field name="terapi" class="java.lang.String"/>
	<field name="diagnosa" class="java.lang.String"/>
	<field name="tindakan" class="java.lang.String"/>
	<field name="kondisi_pulang" class="java.lang.String"/>
	<field name="obat_pulang" class="java.lang.String"/>
