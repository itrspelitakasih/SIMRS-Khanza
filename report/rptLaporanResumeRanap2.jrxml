<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptLaporanResumeRanap2" pageWidth="595" pageHeight="842" columnWidth="540" leftMargin="28" rightMargin="27" topMargin="20" bottomMargin="20" uuid="bdfba702-6464-468a-991e-36a29e78f98f">
