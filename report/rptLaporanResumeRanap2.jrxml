<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptLaporanResumeRanap2" pageWidth="595" pageHeight="842" columnWidth="540" leftMargin="28" rightMargin="27" topMargin="20" bottomMargin="20" uuid="5ad2faff-3339-4593-a920-72a1da583a48">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="ruang" class="java.lang.String"/>
	<parameter name="norawat" class="java.lang.String"/>
	<parameter name="tanggalkeluar" class="java.lang.String"/>
	<parameter name="finger2" class="java.lang.String"/>
	<parameter name="finger3" class="java.lang.String"/>
