	<queryString>
		<![CDATA[select reg_periksa.no_rawat,reg_periksa.no_rkm_medis,pasien.nm_pasien,pasien.jk,date_format(pasien.tgl_lahir,'%d-%m-%Y') as tgllahir,
concat(reg_periksa.umurdaftar,' ',reg_periksa.sttsumur) as umur,concat(pasien.alamat,', ',kelurahan.nm_kel,', ',kecamatan.nm_kec,', ',kabupaten.nm_kab) as alamat,
dokter.nm_dokter,
concat(date_format(reg_periksa.tgl_registrasi,'%d-%m-%Y'),' ',reg_periksa.jam_reg) as tglmasuk,
concat_ws('\n\n',nullif(resume_pasien_ranap.keluhan_utama,''),if(ifnull(resume_pasien_ranap.jalannya_penyakit,'')<>'',concat('Jalannya penyakit selama perawatan :\n',resume_pasien_ranap.jalannya_penyakit),null),if(ifnull(resume_pasien_ranap.alergi,'')<>'',concat('Alergi / reaksi obat :\n',resume_pasien_ranap.alergi),null)) as riwayat,
concat_ws('\n\n',nullif(resume_pasien_ranap.hasil_laborat,''),if(ifnull(resume_pasien_ranap.lab_belum,'')<>'',concat('Hasil lab yang belum selesai :\n',resume_pasien_ranap.lab_belum),null)) as lab,
resume_pasien_ranap.pemeriksaan_fisik,resume_pasien_ranap.pemeriksaan_penunjang,resume_pasien_ranap.obat_di_rs,
concat_ws('\n',if(ifnull(resume_pasien_ranap.diagnosa_utama,'')<>'',concat('Diagnosa Utama : ',resume_pasien_ranap.diagnosa_utama,if(ifnull(resume_pasien_ranap.kd_diagnosa_utama,'')<>'',concat(' (',resume_pasien_ranap.kd_diagnosa_utama,')'),'')),null),if(ifnull(resume_pasien_ranap.diagnosa_sekunder,'')<>'',concat('Diagnosa Sekunder : ',resume_pasien_ranap.diagnosa_sekunder,if(ifnull(resume_pasien_ranap.kd_diagnosa_sekunder,'')<>'',concat(' (',resume_pasien_ranap.kd_diagnosa_sekunder,')'),'')),null),if(ifnull(resume_pasien_ranap.diagnosa_sekunder2,'')<>'',concat('Diagnosa Sekunder : ',resume_pasien_ranap.diagnosa_sekunder2,if(ifnull(resume_pasien_ranap.kd_diagnosa_sekunder2,'')<>'',concat(' (',resume_pasien_ranap.kd_diagnosa_sekunder2,')'),'')),null),if(ifnull(resume_pasien_ranap.diagnosa_sekunder3,'')<>'',concat('Diagnosa Sekunder : ',resume_pasien_ranap.diagnosa_sekunder3,if(ifnull(resume_pasien_ranap.kd_diagnosa_sekunder3,'')<>'',concat(' (',resume_pasien_ranap.kd_diagnosa_sekunder3,')'),'')),null),if(ifnull(resume_pasien_ranap.diagnosa_sekunder4,'')<>'',concat('Diagnosa Sekunder : ',resume_pasien_ranap.diagnosa_sekunder4,if(ifnull(resume_pasien_ranap.kd_diagnosa_sekunder4,'')<>'',concat(' (',resume_pasien_ranap.kd_diagnosa_sekunder4,')'),'')),null)) as diagnosa,
concat_ws('\n',nullif(resume_pasien_ranap.tindakan_dan_operasi,''),if(ifnull(resume_pasien_ranap.prosedur_utama,'')<>'',concat('Prosedur Utama : ',resume_pasien_ranap.prosedur_utama,if(ifnull(resume_pasien_ranap.kd_prosedur_utama,'')<>'',concat(' (',resume_pasien_ranap.kd_prosedur_utama,')'),'')),null),if(ifnull(resume_pasien_ranap.prosedur_sekunder,'')<>'',concat('Prosedur Sekunder : ',resume_pasien_ranap.prosedur_sekunder,if(ifnull(resume_pasien_ranap.kd_prosedur_sekunder,'')<>'',concat(' (',resume_pasien_ranap.kd_prosedur_sekunder,')'),'')),null),if(ifnull(resume_pasien_ranap.prosedur_sekunder2,'')<>'',concat('Prosedur Sekunder : ',resume_pasien_ranap.prosedur_sekunder2,if(ifnull(resume_pasien_ranap.kd_prosedur_sekunder2,'')<>'',concat(' (',resume_pasien_ranap.kd_prosedur_sekunder2,')'),'')),null),if(ifnull(resume_pasien_ranap.prosedur_sekunder3,'')<>'',concat('Prosedur Sekunder : ',resume_pasien_ranap.prosedur_sekunder3,if(ifnull(resume_pasien_ranap.kd_prosedur_sekunder3,'')<>'',concat(' (',resume_pasien_ranap.kd_prosedur_sekunder3,')'),'')),null)) as tindakan,
resume_pasien_ranap.cara_keluar,resume_pasien_ranap.ket_keluar,resume_pasien_ranap.keadaan,resume_pasien_ranap.ket_keadaan,resume_pasien_ranap.dilanjutkan,
concat_ws('\n\n',nullif(resume_pasien_ranap.obat_pulang,''),if(ifnull(resume_pasien_ranap.diet,'')<>'',concat('Diet :\n',resume_pasien_ranap.diet),null),if(ifnull(resume_pasien_ranap.edukasi,'')<>'',concat('Instruksi / edukasi :\n',resume_pasien_ranap.edukasi),null),concat('Dilanjutkan : ',resume_pasien_ranap.dilanjutkan,if(ifnull(resume_pasien_ranap.ket_dilanjutkan,'')<>'',concat(', ',resume_pasien_ranap.ket_dilanjutkan),'')),if(year(resume_pasien_ranap.kontrol)>0,concat('Tanggal kontrol : ',date_format(resume_pasien_ranap.kontrol,'%d-%m-%Y %H:%i')),null)) as lanjut
from resume_pasien_ranap inner join reg_periksa on resume_pasien_ranap.no_rawat=reg_periksa.no_rawat
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
inner join kelurahan on pasien.kd_kel=kelurahan.kd_kel inner join kecamatan on pasien.kd_kec=kecamatan.kd_kec
inner join kabupaten on pasien.kd_kab=kabupaten.kd_kab
inner join dokter on resume_pasien_ranap.kd_dokter=dokter.kd_dokter
where resume_pasien_ranap.no_rawat=$P{norawat}]]>
	</queryString>
