	<queryString>
		<![CDATA[select surat_keterangan_menemani_berobat.no_surat,surat_keterangan_menemani_berobat.no_rawat,reg_periksa.no_rkm_medis,pasien.nm_pasien,
                        date_format(reg_periksa.tgl_registrasi,'%d-%m-%Y') as tgl_registrasi,reg_periksa.p_jawab,reg_periksa.almt_pj,reg_periksa.hubunganpj,pasien.pekerjaanpj,
                        date_format(surat_keterangan_menemani_berobat.tanggal_surat,'%d-%m-%Y') as tanggal_surat,poliklinik.nm_poli,dokter.nm_dokter,dokter.no_ijn_praktek
                        from surat_keterangan_menemani_berobat inner join reg_periksa on surat_keterangan_menemani_berobat.no_rawat=reg_periksa.no_rawat
                        inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis inner join dokter on dokter.kd_dokter=reg_periksa.kd_dokter
                        inner join poliklinik on reg_periksa.kd_poli=poliklinik.kd_poli]]>
	</queryString>
